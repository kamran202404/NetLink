{
  "name": "netlink",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @netlink/desktop dev",
    "build": "pnpm --filter @netlink/core build && pnpm --filter @netlink/ui build && pnpm --filter @netlink/desktop build",
