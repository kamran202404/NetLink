    "lint": "pnpm -r lint",
    "test": "pnpm --filter @netlink/core test"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
